{
  "name": "open-routines-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Open Routines — Desktop App",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "rm -rf out && electron-forge make",
    "pipeline-checks": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test": "npm run test:frontend && npm run test:backend",
    "postinstall": "electron-rebuild",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@opencode-ai/sdk": "^1.4.6",
    "better-sqlite3": "^11.4.0",
    "chokidar": "^4.0.0",
    "classnames": "^2.5.1",
    "hono": "^4.6.0",
    "node-cron": "^3.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "remark-gfm": "^4.0.1",
    "zod": "^3.23.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@electron/rebuild": "^3.7.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^35.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
